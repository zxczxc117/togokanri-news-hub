{
  "id": "itainews",
  "name": "痛いニュース",
  "category": "MATOME",
  "enabled": true,
  "allowFullText": true,
  "maxItems": 80,
  "listing": {
    "type": "html",
    "urls": [
      "https://itainews.com/"
    ],
    "linkSelector": "h3.title.entry-title a",
    "linkAttr": "href",
    "urlIncludePatterns": [
      "^https://itainews\\.com/archives/\\d+\\.html$"
    ],
    "urlExcludePatterns": [],
    "pagination": {
      "enabled": true,
      "nextUrlTemplate": "https://itainews.com/?p={page}",
      "startPage": 1,
      "maxPages": 2196
    }
  },
  "article": {
  "titleSelectors": [
    "h1"
  ],
  "bodySelectors": [
     "#articlebody"
  ],
  "dropSelectors": [
    "script",
    "style",
    "nav",
    "footer",
    "aside",
    ".ad",
    ".ads",
    ".banner",
    ".related",
    ".recommend",
    ".ranking",
    ".share",
    ".social",
    ".breadcrumb"
  ],
  "imageSelectors": [
    "meta[property='og:image']",
    "meta[name='twitter:image']"
  ],
  "dateSelectors": [
    "#articlebody .datebody abbr.updated[title]",
    "meta[property='article:published_time']",
    "time[datetime]"
  ],
  "stopAtTexts": [
    "関連記事",
    "あわせて読みたい",
    "おすすめ記事"
  ],
  "minParagraphChars": 15
  },
  "notes": "livedoor Blog。RDF(RSS1.0)。本文は article-body-inner に入る。"
}
