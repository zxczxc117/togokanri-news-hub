{
  "id": "gihyo",
  "name": "gihyo.jp",
  "category": "TECH",
  "enabled": true,
  "allowFullText": true,
  "maxItems": 80,
  "listing": {
    "type": "rss",
    "urls": [
      "https://gihyo.jp/feed/rss2"
    ],
    "linkSelector": "",
    "linkAttr": "href",
    "urlIncludePatterns": [],
    "urlExcludePatterns": []
  },
  "article": {
    "titleSelectors": [
      "h1"
    ],
    "bodySelectors": [
      "div.article-body",
      "article"
    ],
    "dropSelectors": [
      "script",
      "style",
      "nav",
      "footer",
      "aside",
      ".ad",
      ".ads",
      ".banner",
      ".related",
      ".recommend",
      ".ranking",
      ".share",
      ".social",
      ".breadcrumb"
    ],
    "imageSelectors": [
      "meta[property='og:image']",
      "meta[name='twitter:image']"
    ],
    "dateSelectors": [
      "meta[property='article:published_time']",
      "time[datetime]"
    ],
    "stopAtTexts": [
      "関連記事",
      "あわせて読みたい",
      "おすすめ記事"
    ],
    "minParagraphChars": 25
  },
  "notes": ""
}
