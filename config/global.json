{
  "schemaVersion": 1,
  "publishDir": "public",
  "stateDir": "state",
  "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36",
  "requestTimeoutSec": 20,
  "sleepBetweenRequestsSec": 1.0,
  "retryCount": 2,
  "retryBackoffSec": 3,
  "maxItemsPerSite": 80,
  "maxNewArticlesPerRun": 40,
  "recheckHours": 24,
  "bodyMaxChars": 20000,
  "bodyMinChars": 200,
  "keepDays": 14,
  "includeBody": true,
  "includeImage": true
}
